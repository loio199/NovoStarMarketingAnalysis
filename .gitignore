# Python cache and compiled files
__pycache__/
*.py[cod]
*.so

# Python environments
.venv/
venv/
env/
ENV/
conda-env/

# Jupyter Notebook
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# IDE settings
.idea/
.vscode/

# Python build and package metadata
*.egg-info/
build/
dist/
.eggs/

# Testing and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables and logs
.env
.env.*
*.log

# Generated and processed data
data/processed/*
!data/processed/.gitkeep

# Generated outputs
outputs/figures/*
outputs/tables/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep